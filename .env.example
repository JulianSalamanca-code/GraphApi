# MrCatFood - Variables de entorno
# Copia este archivo como .env y ajusta los valores según tu entorno

# Service Discovery
CONSUL_HOST=consul

# Database paths (SQLite)
DB_PATH=/data

# Service ports
USUARIOS_SERVICE_PORT=3001
ORDENES_SERVICE_PORT=3002
PEDIDOS_SERVICE_PORT=3003
PAGOS_SERVICE_PORT=3004
COSMO_ROUTER_PORT=3000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
