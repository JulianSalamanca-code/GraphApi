meta {
  name: 04 - Actualizar orden
  type: graphql
  seq: 4
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation ActualizarOrden($id: ID!, $estado: String) {
    actualizarOrden(id: $id, estado: $estado) {
      id
      estado
      total
      actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "id": "be1b933d-2684-4694-a13f-eb6b98c44cd2",
    "estado": "PAGADA"
  }
}

docs {
  Solo se puede modificar el estado. El propietario es inmutable.
}
