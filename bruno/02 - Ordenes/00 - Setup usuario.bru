meta {
  name: 00 - Setup usuario
  type: graphql
  seq: 0
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation SetupUsuario($input: CrearUsuarioInput!) {
    crearUsuario(input: $input) { id }
  }
}

body:graphql:vars {
  {
    "input": { "nombre": "Usuario Ordenes", "email": "ordenes_{{ordRun}}@example.com" }
  }
}

script:pre-request {
  bru.setVar("ordRun", String(Date.now()));
}

script:post-response {
  bru.setVar("ordUsuId", res.body.data.crearUsuario.id);
}

assert {
  res.status: eq 200
  res.body.data.crearUsuario.id: isDefined
}

docs {
  Crea el usuario propietario de las ordenes.
}
