meta {
  name: 03 - Crear orden
  type: graphql
  seq: 3
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearOrden($usuarioId: ID!) {
    crearOrden(usuarioId: $usuarioId) {
      id
      estado
      usuarioId
      total
      creadoEn
      actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "usuarioId": "c4071df6-142d-49db-a188-fa8c2f52d55f"
  }
}

docs {
  Se crea con estado PENDIENTE y total 0. El propietario queda fijado.
}
