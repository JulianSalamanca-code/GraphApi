meta {
  name: 14 - Eliminar orden
  type: graphql
  seq: 14
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation EliminarOrden($id: ID!) {
    eliminarOrden(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "{{ordNuevaId}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.eliminarOrden: eq true
}

docs {
  Elimina la segunda orden (sin pedidos ni pagos).
}
