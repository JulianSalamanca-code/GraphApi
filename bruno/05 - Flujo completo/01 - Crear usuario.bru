meta {
  name: 01 - Crear usuario
  type: graphql
  seq: 1
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearUsuario($nombre: String!, $email: String!, $telefono: String) {
    crearUsuario(nombre: $nombre, email: $email, telefono: $telefono) {
      id
      nombre
      email
      telefono
      activo
    }
  }
}

body:graphql:vars {
  {
    "nombre": "María Pérez",
    "email": "maria@example.com",
    "telefono": "+34 600 000 000"
  }
}

script:post-response {
  const data = res.body.data;
  if (data && data.crearUsuario && data.crearUsuario.id) {
    bru.setVar("flowUsuarioId", data.crearUsuario.id);
  }
}

docs {
  Ejecuta los pasos en orden; cada uno captura los id para los siguientes.
}
