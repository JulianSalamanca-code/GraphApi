meta {
  name: 05 - Crear pago
  type: graphql
  seq: 5
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearPago($input: CrearPagoInput!) {
    crearPago(input: $input) {
      id
      monto
      metodo
      estado
      referencia
      ordenId
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "monto": 30,
      "metodo": "TARJETA",
      "estado": "APROBADO",
      "referencia": "REF-001",
      "ordenId": "{{flowOrdenId}}"
    }
  }
}

script:post-response {
  const data = res.body.data;
  if (data && data.crearPago && data.crearPago.id) {
    bru.setVar("flowPagoId", data.crearPago.id);
  }
}