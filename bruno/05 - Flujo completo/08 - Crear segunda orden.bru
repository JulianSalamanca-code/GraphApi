meta {
  name: 08 - Crear segunda orden
  type: graphql
  seq: 8
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearSegundaOrden($usuarioId: ID!) {
    crearOrden(usuarioId: $usuarioId) {
      id
      estado
      total
    }
  }
}

body:graphql:vars {
  {
    "usuarioId": "{{flowUsuarioId}}"
  }
}

script:post-response {
  const data = res.body.data;
  if (data && data.crearOrden && data.crearOrden.id) {
    bru.setVar("flowOrden2Id", data.crearOrden.id);
  }
}
