meta {
  name: 09 - Mover pedido a la segunda orden
  type: graphql
  seq: 9
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation MoverPedido($id: ID!, $ordenId: ID!) {
    actualizarPedido(id: $id, input: { ordenId: $ordenId }) {
      id
      usuarioId
      ordenId
      subtotal
    }
  }
}

body:graphql:vars {
  {
    "id": "{{flowPedidoId}}",
    "ordenId": "{{flowOrden2Id}}"
  }
}

docs {
  La nueva orden debe pertenecer al mismo usuario. Se recalculan los
  totales de ambas órdenes.
}
