meta {
  name: 08 - Mover pedido a otra orden
  type: graphql
  seq: 8
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation MoverPedido($id: ID!, $ordenId: ID!) {
    actualizarPedido(id: $id, input: { ordenId: $ordenId }) {
      id
      usuarioId
      ordenId
      subtotal
      orden {
        id
        estado
        total
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-4000-8000-000000000003",
    "ordenId": "00000000-0000-4000-8000-000000000004"
  }
}

assert {
  res.status: eq 200
}

docs {
  La nueva orden debe pertenecer al mismo usuario. Se recalculan los
  totales de ambas órdenes.
}