meta {
  name: 18 - Eliminar pedido
  type: graphql
  seq: 18
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation EliminarPedido($id: ID!) {
    eliminarPedido(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "{{ped2Id}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.eliminarPedido: eq true
}

docs {
  Elimina el segundo pedido.
}
