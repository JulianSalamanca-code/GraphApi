meta {
  name: 15 - Crear pedido
  type: graphql
  seq: 15
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearPedido($input: CrearPedidoInput!) {
    crearPedido(input: $input) { id producto cantidad precioUnitario subtotal }
  }
}

body:graphql:vars {
  {
    "input": {
      "producto": "Pedido Nuevo",
      "descripcion": "Creado por la coleccion",
      "cantidad": 1,
      "precioUnitario": 5,
      "usuarioId": "{{pedUsuId}}",
      "ordenId": "{{pedOrdId}}"
    }
  }
}

script:post-response {
  bru.setVar("ped2Id", res.body.data.crearPedido.id);
}

assert {
  res.status: eq 200
  res.body.data.crearPedido.id: isDefined
}

docs {
  Crea un segundo pedido.
}
