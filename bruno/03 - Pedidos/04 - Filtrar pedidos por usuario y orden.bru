meta {
  name: 04 - Filtrar pedidos por usuario y orden
  type: graphql
  seq: 4
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query PedidosDeUsuarioEnOrden($usuarioId: ID!, $ordenId: ID!) {
    pedidos(usuarioId: $usuarioId, ordenId: $ordenId) {
      id
      producto
      cantidad
      subtotal
    }
  }
}

body:graphql:vars {
  {
    "usuarioId": "00000000-0000-4000-8000-000000000001",
    "ordenId": "00000000-0000-4000-8000-000000000002"
  }
}

assert {
  res.status: eq 200
}

docs {
  Los filtros se combinan con AND. Omitir un filtro o enviar null equivale a no filtrar.
}