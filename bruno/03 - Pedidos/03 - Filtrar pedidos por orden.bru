meta {
  name: 03 - Filtrar pedidos por orden
  type: graphql
  seq: 3
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query PedidosDeOrden($ordenId: ID!) {
    pedidos(ordenId: $ordenId) {
      id
      producto
      cantidad
      subtotal
      usuario {
        id
        nombre
      }
    }
  }
}

body:graphql:vars {
  {
    "ordenId": "00000000-0000-4000-8000-000000000002"
  }
}

docs {
  Devuelve los pedidos de esa orden. Sustituye el id por un UUID real.
}