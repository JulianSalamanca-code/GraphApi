meta {
  name: 01 - Listar todos los pedidos
  type: graphql
  seq: 1
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query ListarPedidos {
    pedidos {
      id
      producto
      descripcion
      cantidad
      precioUnitario
      subtotal
      usuarioId
      ordenId
      creadoEn
      actualizadoEn
    }
  }
}

assert {
  res.status: eq 200
}

docs {
  Sin filtros, devuelve todos los pedidos.
  Subtotales: cantidad x precioUnitario.
}