meta {
  name: 05 - Obtener pedido por id
  type: graphql
  seq: 5
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query ObtenerPedido($id: ID!) {
    pedido(id: $id) {
      id
      producto
      descripcion
      cantidad
      precioUnitario
      subtotal
      usuarioId
      usuario {
        id
        nombre
        email
      }
      ordenId
      orden {
        id
        estado
        total
      }
      creadoEn
      actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-4000-8000-000000000003"
  }
}

docs {
  Sustituye el id por el UUID de un pedido existente.
}