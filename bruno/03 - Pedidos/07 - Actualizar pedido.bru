meta {
  name: 07 - Actualizar pedido
  type: graphql
  seq: 7
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation ActualizarPedido($id: ID!, $input: ActualizarPedidoInput!) {
    actualizarPedido(id: $id, input: $input) {
      id
      producto
      cantidad
      precioUnitario
      subtotal
      usuarioId
      ordenId
      actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-4000-8000-000000000003",
    "input": {
      "cantidad": 4,
      "precioUnitario": 11.5
    }
  }
}

assert {
  res.status: eq 200
}

docs {
  Al cambiar cantidad o precio se recalcula el subtotal y el total de la orden.
  Una descripción vacía o solo espacios se convierte en null.
}