meta {
  name: 01 - Listar todos los pagos
  type: graphql
  seq: 1
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query ListarPagos {
    pagos {
      id
      monto
      metodo
      estado
      referencia
      ordenId
      orden {
        id
        total
      }
      creadoEn
      actualizadoEn
    }
  }
}

docs {
  Sin filtros, devuelve todos los pagos.
  El monto no se compara automáticamente con el total de la orden.
}