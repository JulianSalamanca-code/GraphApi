meta {
  name: 99 - Teardown
  type: graphql
  seq: 99
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation Teardown {
    eliminarPago(id: "{{pagId}}")
    eliminarOrdenA: eliminarOrden(id: "{{pagOrdId}}")
    eliminarOrdenB: eliminarOrden(id: "{{pagOrd2Id}}")
    eliminarUsuario(id: "{{pagUsuId}}")
  }
}

assert {
  res.status: eq 200
}

docs {
  Limpia pago, ordenes y usuario.
}
