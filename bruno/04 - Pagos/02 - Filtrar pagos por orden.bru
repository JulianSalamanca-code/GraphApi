meta {
  name: 02 - Filtrar pagos por orden
  type: graphql
  seq: 2
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query PagosDeOrden($ordenId: ID!) {
    pagos(ordenId: $ordenId) {
      id
      monto
      metodo
      estado
      referencia
    }
  }
}

body:graphql:vars {
  {
    "ordenId": "00000000-0000-4000-8000-000000000002"
  }
}

docs {
  Devuelve únicamente los pagos de la orden indicada.
  Omitir ordenId o enviarlo como null devuelve todos los pagos.
}