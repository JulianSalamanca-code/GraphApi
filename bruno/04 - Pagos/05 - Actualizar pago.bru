meta {
  name: 05 - Actualizar pago
  type: graphql
  seq: 5
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation ActualizarPago($id: ID!, $input: ActualizarPagoInput!) {
    actualizarPago(id: $id, input: $input) {
      id
      monto
      metodo
      estado
      referencia
      ordenId
      actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-4000-8000-000000000005",
    "input": {
      "estado": "APROBADO"
    }
  }
}

docs {
  Solo modifica los campos enviados.
}
