meta {
  name: 06 - Mover pago a otra orden
  type: graphql
  seq: 6
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation MoverPago($id: ID!, $ordenId: ID!) {
    actualizarPago(id: $id, input: { ordenId: $ordenId }) {
      id
      ordenId
      estado
    }
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-4000-8000-000000000005",
    "ordenId": "00000000-0000-4000-8000-000000000006"
  }
}

docs {
  La nueva orden debe existir.
}
