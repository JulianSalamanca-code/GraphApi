meta {
  name: 03 - Obtener pago por id
  type: graphql
  seq: 3
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query ObtenerPago($id: ID!) {
    pago(id: $id) {
      id
      monto
      metodo
      estado
      referencia
      ordenId
      orden {
        id
        estado
        total
      }
      creadoEn
      actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-4000-8000-000000000005"
  }
}

docs {
  Sustituye el id por el UUID de un pago existente.
}