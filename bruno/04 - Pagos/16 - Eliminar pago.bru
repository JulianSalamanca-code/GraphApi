meta {
  name: 16 - Eliminar pago
  type: graphql
  seq: 16
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation EliminarPago($id: ID!) {
    eliminarPago(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "{{pag2Id}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.eliminarPago: eq true
}

docs {
  Elimina el segundo pago.
}
