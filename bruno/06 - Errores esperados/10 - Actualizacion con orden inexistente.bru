meta {
  name: 10 - Actualizacion con orden inexistente
  type: graphql
  seq: 10
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation ActualizarConOrdenInexistente($id: ID!, $ordenId: ID!) {
    actualizarPedido(id: $id, input: { ordenId: $ordenId }) {
      id
      ordenId
    }
    actualizarPago(id: $id, input: { ordenId: $ordenId }) {
      id
      ordenId
    }
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-4000-8000-000000000003",
    "ordenId": "99999999-9999-4999-8999-999999999999"
  }
}

docs {
  Si el nueva orden no existe, la entidad conserva todos sus valores anteriores.
  Esperado: error por cada adaptación con orden inexistente.
}