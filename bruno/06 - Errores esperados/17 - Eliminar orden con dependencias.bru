meta {
  name: 17 - Eliminar orden con dependencias
  type: graphql
  seq: 17
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation EliminarOrdenInvalida($id: ID!) {
    eliminarOrden(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "{{errOrdenAId}}"
  }
}

assert {
  res.status: eq 200
  res.body.data: isNull
  res.body.errors[0].message: contains pedidos asociados
}

docs {
  La orden owner tiene pedidos y pagos. Esperado: no se elimina.
}
