meta {
  name: 99 - Teardown
  type: graphql
  seq: 99
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation Teardown {
    eliminarPago(id: "{{errPagoAId}}")
    eliminarPedido(id: "{{errPedidoAId}}")
    eliminarOrden(id: "{{errOrdenAId}}")
    eliminarUsuario(id: "{{errUsuarioAId}}")
    eliminarUsuarioB: eliminarUsuario(id: "{{errUsuarioBId}}")
  }
}

assert {
  res.status: eq 200
}

docs {
  Limpia los datos creados por el setup para permitir re-ejecuciones.
}
