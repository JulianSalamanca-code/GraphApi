meta {
  name: 14 - Pedido con propietario incorrecto
  type: graphql
  seq: 14
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearPedidoInvalido($input: CrearPedidoInput!) {
    crearPedido(input: $input) { id }
  }
}

body:graphql:vars {
  {
    "input": {
      "producto": "Producto con propietario ajeno",
      "cantidad": 1,
      "precioUnitario": 10,
      "usuarioId": "{{errUsuarioBId}}",
      "ordenId": "{{errOrdenAId}}"
    }
  }
}

assert {
  res.status: eq 200
  res.body.data: isNull
  res.body.errors[0].message: contains propietario
}

docs {
  usuarioId debe ser el propietario de la orden. Esperado: rechazo.
}
