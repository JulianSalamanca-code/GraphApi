meta {
  name: 01 - Email duplicado
  type: graphql
  seq: 1
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearUsuario($input: CrearUsuarioInput!) {
    crearUsuario(input: $input) {
      id
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "nombre": "Usuario Repetido",
      "email": "duplicado@example.com"
    }
  }
}

docs {
  Ejecútalo dos veces. La segunda debe responder con data: null y
  errors[0].message: "Ya existe un usuario con ese email.".
}