meta {
  name: 01 - Email duplicado
  type: graphql
  seq: 1
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearUsuario($nombre: String!, $email: String!, $telefono: String) {
    crearUsuario(nombre: $nombre, email: $email, telefono: $telefono) {
      id
    }
  }
}

body:graphql:vars {
  {
    "nombre": "Usuario Repetido",
    "email": "duplicado@example.com"
  }
}

docs {
  Ejecútalo dos veces. La segunda debe responder con data: null y
  errors[0].message: "El email ya está registrado: duplicado@example.com".
}
