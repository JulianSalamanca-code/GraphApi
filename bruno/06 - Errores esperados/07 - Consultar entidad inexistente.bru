meta {
  name: 07 - Consultar entidad inexistente
  type: graphql
  seq: 7
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query EntidadInexistente($id: ID!) {
    usuario(id: $id) {
      id
      nombre
    }
    orden(id: $id) {
      id
      estado
    }
    pedido(id: $id) {
      id
    }
    pago(id: $id) {
      id
    }
  }
}

body:graphql:vars {
  {
    "id": "99999999-9999-4999-8999-999999999999"
  }
}

assert {
  res.status: eq 200
}

docs {
  Esperado: cada campo con error de NotFound y el resto de la consulta sigue viva.
}