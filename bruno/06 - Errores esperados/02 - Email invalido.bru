meta {
  name: 02 - Email invalido
  type: graphql
  seq: 2
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearUsuario($nombre: String!, $email: String!, $telefono: String) {
    crearUsuario(nombre: $nombre, email: $email, telefono: $telefono) {
      id
    }
  }
}

body:graphql:vars {
  {
    "nombre": "Usuario Con Email Invalido",
    "email": "no-es-un-email"
  }
}

docs {
  Esperado: data: null y errors con mensaje que contiene "Bad Request".
}
