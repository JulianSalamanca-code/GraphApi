meta {
  name: 05 - Pedido con propietario incorrecto
  type: graphql
  seq: 5
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearPedidoInvalido($input: CrearPedidoInput!) {
    crearPedido(input: $input) {
      id
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "producto": "Producto con propietario ajeno",
      "cantidad": 1,
      "precioUnitario": 10,
      "usuarioId": "00000000-0000-4000-8000-000000000009",
      "ordenId": "00000000-0000-4000-8000-000000000002"
    }
  }
}

assert {
  res.status: eq 200
}

docs {
  usuarioId debe coincidir con el propietario de la orden.
  Esperado: creación rechazada y el pedido no se crea.
}