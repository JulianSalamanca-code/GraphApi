meta {
  name: 15 - Orden inexistente en pedido
  type: graphql
  seq: 15
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearPedidoInvalido($input: CrearPedidoInput!) {
    crearPedido(input: $input) { id }
  }
}

body:graphql:vars {
  {
    "input": {
      "producto": "Producto huerfano",
      "cantidad": 1,
      "precioUnitario": 10,
      "usuarioId": "{{errUsuarioAId}}",
      "ordenId": "99999999-9999-4999-8999-999999999999"
    }
  }
}

assert {
  res.status: eq 200
  res.body.data: isNull
  res.body.errors[0].message: contains Orden con id
}

docs {
  Orden inexistente. Esperado: error que menciona "Orden con id".
}
