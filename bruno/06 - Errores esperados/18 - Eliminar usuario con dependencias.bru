meta {
  name: 18 - Eliminar usuario con dependencias
  type: graphql
  seq: 18
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation EliminarUsuarioInvalido($id: ID!) {
    eliminarUsuario(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "{{errUsuarioAId}}"
  }
}

assert {
  res.status: eq 200
  res.body.data: isNull
  res.body.errors[0].message: contains eliminar un usuario
}

docs {
  El usuario owner tiene ordenes y pedidos. Esperado: no se elimina.
}
