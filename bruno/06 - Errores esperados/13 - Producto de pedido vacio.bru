meta {
  name: 13 - Producto de pedido vacio
  type: graphql
  seq: 13
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearPedido($input: CrearPedidoInput!) {
    crearPedido(input: $input) { id }
  }
}

body:graphql:vars {
  {
    "input": {
      "producto": "   ",
      "cantidad": 1,
      "precioUnitario": 10,
      "usuarioId": "{{errUsuarioAId}}",
      "ordenId": "{{errOrdenAId}}"
    }
  }
}

assert {
  res.status: eq 200
  res.body.data: isNull
  res.body.errors[0].message: contains Bad Request
}

docs {
  Producto vacio con usuario y orden validos. Esperado: "Bad Request".
}
