meta {
  name: 04 - Producto de pedido vacio
  type: graphql
  seq: 4
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearPedido($input: CrearPedidoInput!) {
    crearPedido(input: $input) {
      id
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "producto": "   ",
      "cantidad": 1,
      "precioUnitario": 10,
      "usuarioId": "00000000-0000-4000-8000-000000000001",
      "ordenId": "00000000-0000-4000-8000-000000000002"
    }
  }
}

assert {
  res.status: eq 200
}

docs {
  Esperado: data: null y errors con "Bad Request".
  Sustituye los ids por entidades reales.
}