meta {
  name: 02 - Obtener usuario por id
  type: graphql
  seq: 2
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query ObtenerUsuario($id: ID!) {
    usuario(id: $id) { id nombre email telefono activo creadoEn actualizadoEn }
  }
}

body:graphql:vars {
  {
    "id": "{{usuId}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.usuario.id: isDefined
}

docs {
  Obtiene el usuario creado en el setup.
}
