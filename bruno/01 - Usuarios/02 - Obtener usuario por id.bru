meta {
  name: 02 - Obtener usuario por id
  type: graphql
  seq: 2
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query ObtenerUsuario($id: ID!) {
    usuario(id: $id) {
      id
      nombre
      email
      telefono
      activo
      creadoEn
      actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "id": "5983c90e-3779-4dee-b04f-ed328c46804b"
  }
}

docs {
  Sustituye el id por el UUID de un usuario existente.
}
