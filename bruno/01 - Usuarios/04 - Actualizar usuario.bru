meta {
  name: 04 - Actualizar usuario
  type: graphql
  seq: 4
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation ActualizarUsuario($id: ID!, $nombre: String, $email: String, $telefono: String, $activo: Boolean) {
    actualizarUsuario(id: $id, nombre: $nombre, email: $email, telefono: $telefono, activo: $activo) {
      id
      nombre
      email
      telefono
      activo
      actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "id": "e50368dc-ea18-46d8-8a89-3a9e334dd533",
    "nombre": "María Pérez Actualizada",
    "telefono": "+34 611 111 111",
    "activo": false
  }
}

docs {
  Solo modifica los campos enviados. telefono: null elimina el teléfono.
  nombre, email y activo no pueden ser null.
}
