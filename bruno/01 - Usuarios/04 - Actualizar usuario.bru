meta {
  name: 04 - Actualizar usuario
  type: graphql
  seq: 4
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation ActualizarUsuario($id: ID!, $input: ActualizarUsuarioInput!) {
    actualizarUsuario(id: $id, input: $input) {
      id nombre email telefono activo actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "id": "{{usuNuevoId}}",
    "input": { "nombre": "Usuario Actualizado", "telefono": null, "activo": false }
  }
}

assert {
  res.status: eq 200
  res.body.data.actualizarUsuario.activo: eq false
}

docs {
  Actualiza el segundo usuario. telefono null lo elimina.
}
