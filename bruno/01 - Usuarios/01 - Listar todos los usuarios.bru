meta {
  name: 01 - Listar todos los usuarios
  type: graphql
  seq: 1
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query {
    usuarios { id nombre email telefono activo creadoEn actualizadoEn }
  }
}

assert {
  res.status: eq 200
  res.body.data.usuarios: isArray
}

docs {
  Devuelve todos los usuarios.
}
