meta {
  name: 03 - Crear usuario
  type: graphql
  seq: 3
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearUsuario($input: CrearUsuarioInput!) {
    crearUsuario(input: $input) { id nombre email telefono activo creadoEn actualizadoEn }
  }
}

body:graphql:vars {
  {
    "input": {
      "nombre": "Usuario Nuevo",
      "email": "usuarios_nuevo_{{usuRun}}@example.com",
      "telefono": "+34 600 000 000"
    }
  }
}

script:post-response {
  bru.setVar("usuNuevoId", res.body.data.crearUsuario.id);
}

assert {
  res.status: eq 200
  res.body.data.crearUsuario.id: isDefined
}

docs {
  Crea un segundo usuario. Guarda su id para actualizar/eliminar.
}
