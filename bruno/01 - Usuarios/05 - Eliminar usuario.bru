meta {
  name: 05 - Eliminar usuario
  type: graphql
  seq: 5
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation EliminarUsuario($id: ID!) {
    eliminarUsuario(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "{{usuNuevoId}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.eliminarUsuario: eq true
}

docs {
  Elimina el segundo usuario (ya sin dependencias).
}
