meta {
  name: 05 - Eliminar usuario
  type: graphql
  seq: 5
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation EliminarUsuario($id: ID!) {
    eliminarUsuario(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "e50368dc-ea18-46d8-8a89-3a9e334dd533"
  }
}

assert {
  res.status: eq 200
}

docs {
  Devuelve true si el usuario no tiene pedidos ni órdenes.
  Si tiene dependencias, responde con un error de conflicto.
}
