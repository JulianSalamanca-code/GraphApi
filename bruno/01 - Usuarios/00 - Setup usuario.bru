meta {
  name: 00 - Setup usuario
  type: graphql
  seq: 0
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation SetupUsuario($input: CrearUsuarioInput!) {
    crearUsuario(input: $input) { id email }
  }
}

body:graphql:vars {
  {
    "input": { "nombre": "Usuario Listado", "email": "usuarios_{{usuRun}}@example.com" }
  }
}

script:pre-request {
  bru.setVar("usuRun", String(Date.now()));
}

script:post-response {
  bru.setVar("usuId", res.body.data.crearUsuario.id);
}

assert {
  res.status: eq 200
  res.body.data.crearUsuario.id: isDefined
}

docs {
  Crea un usuario base para las operaciones de lectura/actualizacion.
}
