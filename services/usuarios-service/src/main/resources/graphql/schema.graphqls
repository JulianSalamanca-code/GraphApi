type Usuario {
  id: ID!
  nombre: String!
  email: String!
  telefono: String
  activo: Boolean!
  creadoEn: String!
  actualizadoEn: String!
}

type Query {
  usuarios: [Usuario!]!
  usuario(id: ID!): Usuario
}

type Mutation {
  crearUsuario(nombre: String!, email: String!, telefono: String): Usuario!
  actualizarUsuario(id: ID!, nombre: String, email: String, telefono: String, activo: Boolean): Usuario!
  eliminarUsuario(id: ID!): Boolean!
}
